# Temporary reference copy of the official dsh distribution, used while
# reading upstream source. Delete it once it is no longer needed.
.research/

# Dependencies and build output
node_modules/
dist/
coverage/
# NOT `lib/` — the built plugin is committed on purpose. pnpm builds a git
# dependency only when its manifest has a non-empty `prepare`, and requiring
# that permission (per commit) from every user is not an install path, so a
# GitHub-URL install unpacks what is committed here. `pnpm build` writes it;
# `test/lib-artifacts.test.ts` fails when the two drift apart.
# docs/help/dsh-plugin-platform.md has the mechanism and the measurements.
# pnpm's store, when it lands inside the repo (this machine's default)
.pnpm-store/

# Logs and local scratch
*.log
.DS_Store
Thumbs.db

# Anything holding a registry token: `.npmrc` is a credential file, and this
# repository is public.
.npmrc
